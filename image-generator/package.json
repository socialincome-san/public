		"next": "16.4.6",
		"pg": "^8.23.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"server-only": "0.0.1",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@smartive/prettier-config": "3.1.2",
		"@tailwindcss/turbopack": "4.3.5",
		"@types/jest": "30.0.0",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "10.14.0",
		"jest": "30.5.2",
		"eslint-config-next": "16.4.6",
		"knip": "6.45.1",
		"prettier": "3.10.0",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "4.3.5",
		"typescript": "5.9.3"
	}
}
