{
	"name": "image-generator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "next dev --port 3001",
		"build": "next build",
		"start": "next start",
		"lint": "eslint",
		"typecheck": "next typegen && tsc --noEmit",
