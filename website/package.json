{
	"name": "@socialincome/website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"serve": "npm run openapi:generate && npm run db:generate && next dev -p 3000",
		"serve:ssl": "npm run openapi:generate && npm run db:generate && next dev --experimental-https -p 3000",
		"prebuild": "npm run globe:generate-fallback",
		"build": "next build",
		"postbuild": "npm run openapi:generate && npm run copy-static-files",
		"prestart": "npm run db:migrate:deploy",
		"start": "npm-run-all -p start:emulators start:web",
		"start:emulators": "firebase emulators:start --only auth,storage --project demo-social-income-local --config ../firebase.json --import ../seed",
		"start:web": "PORT=${PORT:-3000} HOSTNAME=localhost node .next/standalone/website/server.js",
		"test:unit": "jest --forceExit --roots src/",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots=changed",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --headed --debug",
		"test:e2e:verbose": "DEBUG=pw:webserver npm run test:e2e",
		"test:e2e:ui:verbose": "DEBUG=pw:webserver npm run test:e2e:ui",
		"copy-static-files": "cp -r public .next/standalone/website && cp -r .next/static .next/standalone/website/.next/",
		"emulator:start": "firebase emulators:start --project demo-social-income-local --only firestore,auth,storage --config ../firebase.json --import ../seed",
		"lint": "npm run lint:architecture && eslint .",
		"lint:architecture": "node --test eslint-rules/*.test.mjs",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier --check . --config prettier.config.cjs --ignore-path .prettierignore",
		"format:fix": "prettier --write . --config prettier.config.cjs --ignore-path .prettierignore",
		"openapi:generate": "next-openapi-gen generate",
		"typecheck": "tsc --noEmit",
		"db:generate": "prisma generate",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:reset": "prisma migrate reset --force",
		"db:migrate:status": "prisma migrate status",
		"db:migrate:create": "prisma migrate dev --create-only",
		"db:introspect": "prisma db pull",
		"db:seed": "prisma db seed",
		"db:seed:cms-campaigns": "dotenv -e .env.local -e .env.development -- tsx src/scripts/campaign/seed-cms-campaigns.ts",
		"db:seed:cms-campaigns:apply": "dotenv -e .env.local -e .env.development -- tsx src/scripts/campaign/seed-cms-campaigns.ts --apply",
		"db:seed:cms-campaigns:apply:all": "dotenv -e .env.local -e .env.development -- tsx src/scripts/campaign/seed-cms-campaigns.ts --apply --all",
		"db:backfill:stripe-subscriptions": "tsx src/scripts/stripe/backfill-stripe-subscriptions.ts",
		"db:backfill:bank-subscriptions": "tsx src/scripts/bank/backfill-bank-subscriptions.ts",
		"globe:generate-fallback": "tsx src/scripts/globe/generate-globe-fallback.ts",
		"db:studio": "prisma studio",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose down postgres",
		"check:unused": "knip --config knip.config.ts",
		"storyblok:login": "dotenv -e .env.local -- sh -c 'storyblok login --token $STORYBLOK_PERSONAL_ACCESS_TOKEN --region eu'",
		"storyblok:logout": "dotenv -e .env.local -- sh -c 'storyblok logout'",
		"storyblok:pull": "dotenv -e .env.local -- sh -c 'storyblok --path src/generated/storyblok components pull --space $STORYBLOK_SPACE_ID'",
		"storyblok:types": "dotenv -e .env.local -- sh -c 'storyblok --path src/generated/storyblok types generate --space $STORYBLOK_SPACE_ID'",
		"storyblok:generate": "npm run storyblok:login && npm run storyblok:pull && npm run storyblok:types"
	},
	"dependencies": {
		"@hookform/resolvers": "5.9.1",
		"@lottiefiles/dotlottie-react": "^0.19.10",
		"@mux/mux-video-react": "0.31.4",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@radix-ui/react-accordion": "1.2.20",
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-navigation-menu": "1.2.22",
		"@scalar/api-reference-react": "0.9.76",
		"@sendgrid/client": "8.1.6",
		"@sendgrid/mail": "^8.1.6",
		"@socialincome/design-system": "*",
		"@storyblok/js": "6.3.3",
		"@storyblok/react": "7.0.1",
		"@stripe/react-stripe-js": "7.0.0",
		"@stripe/stripe-js": "9.17.0",
		"@tanstack/react-table": "9.2.4",
		"@xmldom/xmldom": "0.9.12",
		"@xstate/react": "6.1.0",
		"accept-language-parser": "1.5.0",
		"date-fns": "4.4.0",
		"dotenv": "18.0.5",
		"embla-carousel-autoplay": "8.6.0",
		"firebase": "12.19.0",
		"firebase-admin": "14.5.0",
		"globe.gl": "^2.46.1",
		"i18next": "26.4.2",
		"i18next-resources-to-backend": "1.2.3",
		"isomorphic-dompurify": "4.4.0",
		"js-cookie": "3.0.8",
		"lucide-react": "1.49.0",
		"luxon": "3.7.2",
		"motion": "13.4.6",
		"next": "16.3.8",
		"pdfkit": "0.20.2",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-dropzone": "15.0.0",
		"react-hook-form": "7.89.0",
		"react-hot-toast": "2.6.1",
		"react-markdown": "10.1.0",
		"ssh2-sftp-client": "12.1.1",
		"storyblok-rich-text-react-renderer": "3.0.1",
		"stripe": "22.6.2",
		"survey-core": "2.5.45",
		"survey-react-ui": "2.5.45",
		"swissqrbill": "4.4.1",
		"tailwind-merge": "3.6.0",
		"three": "0.186.1",
		"tmp-promise": "3.0.3",
		"twilio": "6.1.2",
		"xstate": "5.32.6",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@smartive/eslint-config": "7.0.3",
		"@smartive/prettier-config": "3.1.2",
		"@tailwindcss/postcss": "4.3.3",
		"@types/accept-language-parser": "1.5.8",
		"@types/d3-geo": "3.1.1",
		"@types/geojson": "7946.0.16",
		"@types/jest": "30.0.0",
		"@types/js-cookie": "3.0.6",
		"@types/luxon": "3.7.6",
		"@types/node": "25.9.9",
		"@types/pdfkit": "0.17.6",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@types/ssh2-sftp-client": "9.0.6",
		"@types/three": "0.186.0",
		"d3-geo": "3.1.1",
		"dotenv-cli": "11.0.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.3.8",
		"eslint-plugin-react": "7.37.5",
		"firebase-tools": "15.32.1",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"knip": "6.39.0",
		"next-openapi-gen": "0.10.5",
		"npm-run-all2": "9.0.3",
		"postcss": "8.5.28",
		"prettier": "3.9.9",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-tailwindcss": "0.8.1",
		"prisma": "7.10.0",
		"storyblok": "4.23.3",
		"ts-jest": "29.4.14",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.0"
	}
}
