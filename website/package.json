{
	"name": "@socialincome/website",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"serve": "npm run openapi:generate && npm run db:generate && next dev -p 3000",
		"serve:ssl": "npm run openapi:generate && npm run db:generate && next dev --experimental-https -p 3000",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"build-storybook:website": "rm -rf public/storybook storybook-static && storybook build && mkdir -p public/storybook && cp -R storybook-static/. public/storybook",
		"prebuild": "npm run globe:generate-fallback",
		"build": "next build",
		"postbuild": "npm run openapi:generate && npm run copy-static-files",
		"prestart": "npm run db:migrate:deploy",
		"start": "npm-run-all -p start:emulators start:web",
		"start:emulators": "firebase emulators:start --only auth,storage --project demo-social-income-local --config ../firebase.json --import ../seed",
		"start:web": "PORT=3000 HOSTNAME=localhost node .next/standalone/website/server.js",
		"test:unit": "jest --forceExit --roots src/",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --headed --debug",
		"test:e2e:verbose": "DEBUG=pw:webserver npm run test:e2e",
		"test:e2e:ui:verbose": "DEBUG=pw:webserver npm run test:e2e:ui",
		"copy-static-files": "cp -r public .next/standalone/website && cp -r .next/static .next/standalone/website/.next/",
		"emulator:start": "firebase emulators:start --project demo-social-income-local --only firestore,auth,storage --config ../firebase.json --import ../seed",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format:check": "prettier --check . --config prettier.config.cjs --ignore-path .prettierignore",
		"format:fix": "prettier --write . --config prettier.config.cjs --ignore-path .prettierignore",
		"openapi:generate": "next-openapi-gen generate",
		"typecheck": "tsc --noEmit",
		"db:generate": "prisma generate",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:reset": "prisma migrate reset --force",
		"db:migrate:status": "prisma migrate status",
		"db:migrate:create": "prisma migrate dev --create-only",
		"db:introspect": "prisma db pull",
		"db:seed": "prisma db seed",
		"db:backfill:stripe-subscriptions": "tsx src/scripts/stripe/backfill-stripe-subscriptions.ts",
		"db:backfill:bank-subscriptions": "tsx src/scripts/bank/backfill-bank-subscriptions.ts",
		"globe:generate-fallback": "tsx src/scripts/globe/generate-globe-fallback.ts",
		"db:studio": "prisma studio",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose down postgres",
		"check:unused": "knip --config knip.config.ts",
		"storyblok:login": "dotenv -e .env.local -- sh -c 'storyblok login --token $STORYBLOK_PERSONAL_ACCESS_TOKEN --region eu'",
		"storyblok:logout": "dotenv -e .env.local -- sh -c 'storyblok logout'",
		"storyblok:pull": "dotenv -e .env.local -- sh -c 'storyblok --path src/generated/storyblok components pull --space $STORYBLOK_SPACE_ID'",
		"storyblok:types": "dotenv -e .env.local -- sh -c 'storyblok --path src/generated/storyblok types generate --space $STORYBLOK_SPACE_ID'",
		"storyblok:generate": "npm run storyblok:login && npm run storyblok:pull && npm run storyblok:types"
	},
	"dependencies": {
		"@hookform/resolvers": "5.9.1",
		"@lottiefiles/dotlottie-react": "^0.19.10",
		"@mux/mux-video-react": "0.31.2",
		"@prisma/adapter-pg": "7.9.1",
		"@prisma/client": "7.9.1",
		"@radix-ui/react-accordion": "1.2.20",
