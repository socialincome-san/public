		"@storybook/addon-docs": "10.6.1",
		"@storybook/nextjs-vite": "10.6.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/jest": "30.0.0",
		"@types/node": "25.9.9",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/parser": "8.71.0",
		"eslint": "9.39.5",
		"eslint-plugin-react": "7.37.5",
		"jest": "30.5.2",
		"jest-environment-jsdom": "30.5.2",
		"knip": "6.39.0",
