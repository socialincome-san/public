{
	"name": "@socialincome/design-system",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		"./styles.css": "./src/styles.css",
		"./cn": "./src/cn.ts",
		"./layout/section-heading/heading-styles": "./src/components/layout/section-heading/heading-styles.ts",
		"./eslint-rules/no-class-name-prop": "./eslint-rules/no-class-name-prop.mjs",
		"./eslint-rules/no-arbitrary-design-values": "./eslint-rules/no-arbitrary-design-values.mjs",
		"./*": "./src/components/*.tsx"
	},
	"scripts": {
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"lint": "node --test eslint-rules/*.test.mjs && eslint src .storybook",
		"lint:fix": "eslint src .storybook --fix",
		"format:check": "prettier --check . --config prettier.config.cjs",
		"format:fix": "prettier --write . --config prettier.config.cjs",
		"typecheck": "tsc --noEmit",
		"check:unused": "knip --config knip.config.ts",
		"test:unit": "jest --forceExit"
	},
	"peerDependencies": {
		"next": "16.3.8",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "7.89.0"
	},
	"dependencies": {
		"@radix-ui/react-accordion": "1.2.20",
